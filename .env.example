# Supabase (backend ใช้ service role — ห้ามเปิดเผยใน frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_QUESTIONS_BUCKET=question-pdfs

# โหมดทดสอบโดยไม่ต่อ Supabase (true = ใช้ mock โจทย์ใน main.py)
USE_MOCK_QUESTIONS=false

# Ollama
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=ai-tutor
OLLAMA_MODEL_GEMMA=ai-tutor
OLLAMA_MODEL_QWEN=ai-tutor-qwen
